# Supabase
SUPABASE_URL=https://<projekt-ref>.supabase.co
# A SECRET key (sb_secret_...), soha nem a publishable — RLS-t kerül meg, csak szerveroldalon
SUPABASE_KEY=

# Admin CSV-export jelszava. Hosszú, véletlen érték; csak X-Admin-Password fejlécben használható.
ADMIN_PASSWORD=

# Opcionális beállítások (a megadott értékek az alapértelmezettek)
ALLOWED_ORIGINS=https://stopjeger.hu,https://www.stopjeger.hu
MAX_SUBMISSIONS_PER_MINUTE=6
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900

# --- Brevo (hírlevél) -------------------------------------------------------
# API-kulcs: Brevo -> SMTP & API -> API Keys. Csak szerveroldalon!
BREVO_API_KEY=
# A lista azonosítója, ahová a MEGERŐSÍTETT címek kerülnek (Brevo -> Contacts -> Lists)
BREVO_LIST_ID=
# Feladó. Aldomainről küldünk, hogy a stopjeger.hu levelezési hírneve elkülönüljön.
MAIL_FROM_EMAIL=hirlevel@news.stopjeger.hu
MAIL_FROM_NAME=JÉGER-kezdeményezés
# A válaszok a rendes postafiókba fussanak be
MAIL_REPLY_TO=info@stopjeger.hu
# A megerősítő hivatkozás alapcíme
SITE_URL=https://stopjeger.hu

# --- Belső felület (/admin) ----------------------------------------------------
# KÖTELEZŐ: hosszú, véletlen titok a belépési kódok HMAC-jéhez (pl. 64 hexa karakter).
# Csere esetén csak a folyamatban lévő belépési kódok válnak érvénytelenné.
ADMIN_AUTH_SECRET=
# Opcionális: külön feladó a meghívó- és belépési kód levelekhez (alapértelmezés: MAIL_FROM_EMAIL)
ADMIN_MAIL_FROM_EMAIL=
# Csak helyi fejlesztéshez, http alatt: false. Élesben NE állítsd be.
# ADMIN_COOKIE_SECURE=false

# --- Vercel Web Analytics lekérdezés a dashboardhoz ------------------------------
# Token: Vercel -> Account Settings -> Tokens
VERCEL_API_TOKEN=
# Projekt: Vercel -> Project -> Settings -> General -> Project ID
VERCEL_PROJECT_ID=
# Csak ha a projekt csapat (team) alatt van: Team Settings -> General -> Team ID
VERCEL_TEAM_ID=
